{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kilagen.com/schemas/gaps.schema.json",
  "title": "Kilagen Gaps Register",
  "description": "Validates program/gaps.yml — open and remediated gaps: unapproved shortfalls against a specific STD-* requirement, distinct from an exception (EXC-*, an approved deviation) and a finding (an untriaged tracker observation). Shape only — id/tracker_id uniqueness, reference resolution, and date ordering are enforced by validate_semantic_refs.py.",

  "$defs": {
    "domain_enum": {
      "type": "string",
      "enum": [
        "grc", "iam", "infra", "appsec",
        "secops", "ir", "offensive",
        "digital-assets", "awareness", "data-security"
      ]
    },
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "role_slug": {
      "type": "string",
      "pattern": "^role-[a-z][a-z0-9-]*$",
      "description": "Reference to a role profile in program/roles/ (e.g. role-security-eng)"
    },
    "severity_enum": {
      "type": "string",
      "enum": ["negligible", "low", "medium", "high", "critical"]
    },
    "source_enum": {
      "type": "string",
      "enum": [
        "risk-assessment", "audit", "pentest",
        "bug-bounty", "threat-model", "internal"
      ]
    },
    "status_enum": {
      "type": "string",
      "enum": ["open", "closed"]
    },
    "related_object": {
      "type": "object",
      "description": "Document IDs the gap relates to, keyed by type. All keys optional.",
      "properties": {
        "risks":      { "type": "array", "items": { "type": "string", "pattern": "^RSK-[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
        "threats":    { "type": "array", "items": { "type": "string", "pattern": "^THR-[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
        "systems":    { "type": "array", "items": { "type": "string", "pattern": "^SYS-[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
        "processes":  { "type": "array", "items": { "type": "string", "pattern": "^PRO-[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true },
        "exceptions": { "type": "array", "items": { "type": "string", "pattern": "^EXC-[a-z0-9][a-z0-9-]*$" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^gap-[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "description": "Unique identifier, kebab-case, gap- prefix. Uniqueness is enforced by validate_semantic_refs.py."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable summary of the shortfall"
        },
        "requirement": {
          "type": "string",
          "pattern": "^STD-[a-z0-9][a-z0-9-]*#[0-9]+(\\.[0-9]+)*$",
          "description": "The STD-* requirement the gap falls short of, as STD-<slug>#<number>"
        },
        "domain": { "$ref": "#/$defs/domain_enum" },
        "owner": { "$ref": "#/$defs/role_slug" },
        "source": { "$ref": "#/$defs/source_enum" },
        "severity": { "$ref": "#/$defs/severity_enum" },
        "tracker_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
          "description": "Immutable Jira issue key (e.g. TS-123) — the stable correlation key between this gap and the tracker. Uniqueness is enforced by validate_semantic_refs.py."
        },
        "tracker": {
          "type": "string",
          "format": "uri",
          "description": "URL to the Jira task tracking remediation"
        },
        "opened": {
          "$ref": "#/$defs/iso_date",
          "$comment": "Non-decreasing ordering opened <= status_updated <= closed_at is enforced in validate_semantic_refs.py (cross-field comparison is not expressible in JSON Schema).",
          "description": "Date the gap was recorded (YYYY-MM-DD)"
        },
        "status": { "$ref": "#/$defs/status_enum" },
        "status_updated": {
          "$ref": "#/$defs/iso_date",
          "$comment": "Must be >= opened; see the ordering note on 'opened'.",
          "description": "Date status was last set (YYYY-MM-DD)"
        },
        "closed_at": {
          "$ref": "#/$defs/iso_date",
          "$comment": "Must be >= status_updated; see the ordering note on 'opened'.",
          "description": "Date the gap was closed (optional)"
        },
        "closure_note": {
          "type": "string",
          "description": "One-line note on what resolved it (optional)"
        },
        "related": { "$ref": "#/$defs/related_object" }
      },
      "required": [
        "id", "title", "requirement", "domain", "owner",
        "source", "severity", "tracker_id", "tracker", "opened",
        "status", "status_updated"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$comment": "A closed gap must record when it closed.",
          "if": {
            "properties": { "status": { "const": "closed" } },
            "required": ["status"]
          },
          "then": { "required": ["closed_at"] }
        },
        {
          "$comment": "An open gap has not closed, so it must not carry closure fields.",
          "if": {
            "properties": { "status": { "const": "open" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "closed_at": false,
              "closure_note": false
            }
          }
        }
      ]
    }
  },

  "type": "object",
  "properties": {
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    }
  },
  "required": ["gaps"],
  "additionalProperties": false
}
